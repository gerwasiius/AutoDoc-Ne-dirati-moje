@rendermode InteractiveServer
@page "/groups"
@using System.Globalization
@using System.Net.Http.Json
@using AutoDocFront.Components.Shared
@using AutoDocFront.Components.Modals

<!--
    Grupe članova (Section Groups) management page.
    Provides filtering, pagination, and CRUD modal for groups.
-->
@if (_loading)
{
    <div class="spinner mt-5"></div>
}
else
{
    <div class="container pb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <h1 class="h2 fw-bold text-dark">Grupe članova</h1>
                <p class="text-secondary">Upravljanje grupama sekcija i članova dokumenta</p>
            </div>
            <button class="btn corporate-button-primary" @onclick="OpenGroupModal">
                <i class="fa fa-plus" aria-hidden="true"></i>
                Nova Grupa
            </button>
        </div>

        <div class="d-flex align-items-center gap-3 mb-3">
            <select class="form-select w-auto corporate-select" value="@statusFilter" @onchange="OnStatusFilterChanged">
                <option value="all">Sve grupe</option>
                <option value="ACTIVE">Aktivne</option>
                <option value="DEACTIVATED">Deaktivirane</option>
            </select>
            <div class="input-group mt-2 mb-2">
                <input @bind="searchTerm"
                       placeholder="Pretraga po nazivu grupe"
                       class="form-control"
                       @bind:event="oninput" />
                <button class="btn corporate-button-secondary" type="button" @onclick="OnSearchClicked">
                    <i class="fa fa-search"></i> Traži
                </button>
                <button class="btn corporate-button-secondary btn-sm ms-1" type="button" @onclick="OnClearFiltersClicked" title="Očisti filtere">
                    <i class="fa fa-eraser" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center text-secondary small mb-2">
            <span>
                Prikazano @(StartIndex + 1)-@EndIndex od @totalCount grupa
            </span>
            @if (TotalPages > 1)
            {
                <span>Stranica @currentPage od @TotalPages</span>
            }
        </div>

        <div class="row g-4">
            @foreach (var group in groups)
            {
                <GroupCard Group="group"
                           Mode="admin"
                           OnEdit="OpenEditGroupModal"
                           OnViewMembers="HandleViewMembers" />
            }
        </div>

        @if (TotalPages > 1)
        {
            <Pagination CurrentPage="@currentPage"
                        TotalPages="@TotalPages"
                        OnPageChanged="ChangePage" />
        }

        @if (!groups.Any())
        {
            <div class="text-center py-5">
                <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle bg-light" style="width: 96px; height: 96px;">
                    <i class="fa fa-search position text-secondary" style="font-size: 2rem;"></i>
                </div>
                <h3 class="h5 fw-medium text-dark mb-2">Nema rezultata</h3>
                <p class="text-secondary">Pokušajte sa drugim terminom pretrage ili kreirajte novu grupu.</p>
            </div>
        }
    </div>
}
@if (isGroupModalOpen)
{
    <GroupModal IsOpen="isGroupModalOpen"
                IsOpenChanged="@(v => isGroupModalOpen = v)"
                Group="selectedGroupForEdit"
                OnSave="CloseGroupModal" />
}
