@page "/placeholders2"
@using AutoDoc.Shared.Model.Placeholders.PlaceholderMetadata
@using AutoDocFront.Components.Modals
@using AutoDocFront.Components.Shared
@using AutoDocFront.Services
@inject PlaceholdersApiService PlaceholdersService

@if (_loading)
{
    <div class="spinner mt-5"></div>
}
else
{
    <div class="container pb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <h1 class="h2 fw-bold text-dark">Placeholderi</h1>
                <p class="text-secondary">Pregled i pretraga placeholdera za šablone dokumenata</p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3 mb-3">
            <select class="form-select w-auto" @bind="SelectedGroup">
                <option value="">Sve grupe</option>
                @foreach (var group in _allGroups)
                {
                    <option value="@group">@group</option>
                }
            </select>

            <div class="input-group mt-2 mb-2">
                <input class="form-control" @bind="_searchTerm" placeholder="Pretraga po nazivu..." />
                <button class="btn corporate-button-secondary" @onclick="OnSearch">
                    <i class="fa fa-search"></i> Traži
                </button>
                <button class="btn corporate-button-secondary btn-sm ms-1" @onclick="OnClear" title="Očisti filtere">
                    <i class="fa fa-eraser" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        @if (_groupedPlaceholders.Count == 0)
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle mx-auto mb-3" style="width: 96px; height: 96px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa fa-search text-secondary" style="font-size: 2rem;"></i>
                </div>
                <h4 class="text-dark mb-2">Nema podataka.</h4>
            </div>
        }
        else
        {
            var groupName = _groupNames[_currentGroupPage - 1];
            var group = _groupedPlaceholders[groupName];

            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-white d-flex align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">@groupName</h5>
                    <span class="badge bg-secondary ms-2">@group.Count placeholdera</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Vrijednost</th>
                                    <th>Naziv</th>
                                    <th>Opis</th>
                                    <th>Tip</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in group)
                                {
                                    <tr>
                                        <td class="text-monospace">@($"{p.Group}.{p.Name}")</td>
                                        <td>@p.Name</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(p.Description))
                                            {
                                                @p.Description
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Nema opisa</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@p.Type</span>
                                        </td>
                                        <td>
                                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ShowDetails(p)">
                                                <i class="bi bi-eye"></i> Detalji
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <nav aria-label="Group pagination" class="d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item @( _currentGroupPage == 1 ? "disabled" : "" )">
                        <button class="page-link" @onclick="PrevGroup" aria-label="Prethodna grupa">&laquo;</button>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link">
                            Grupa @(_currentGroupPage) / @_groupNames.Count
                        </span>
                    </li>
                    <li class="page-item @( _currentGroupPage == _groupNames.Count ? "disabled" : "" )">
                        <button class="page-link" @onclick="NextGroup" aria-label="Sljedeća grupa">&raquo;</button>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

@* Modal za detalje *@
@if (_showDetails && _selectedPlaceholder != null)
{
    <PlaceholderDetailsModal IsOpen="@_showDetails"
                             IsOpenChanged="@(v => _showDetails = v)"
                             Placeholder="_selectedPlaceholder" />
}
