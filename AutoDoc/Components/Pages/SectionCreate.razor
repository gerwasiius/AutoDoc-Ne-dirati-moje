@page "/sections/{groupId:int}/create-section"
@page "/sections/{groupId:int}/edit-section/{sectionId:int}"
@rendermode InteractiveServer
@using AutoDocFront.Components.Shared
@using AutoDocFront.Models
@using AutoDocFront.Models.DTO.GroupSection
@using AutoDocFront.Models.DTO.Sections
@using AutoDocFront.Models.Enumerations
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject IHttpClientFactory httpClientFactory
@inject IToastService toastService

<PageTitle>@(isEditMode ? "Izmjena člana" : "Novi član!")</PageTitle>

<div class="row">
    <div class="col">
        <h3>@(isEditMode ? $"Izmjena člana \"{_model.Name}\"" : "Novi član!")</h3>
    </div>
    <div class="col-auto">
        @if (_group != null)
        {
            <button class="btn btn-icon ml-2" @onclick="HandleValidSubmit" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Spasi">
                <span class="oi oi-check fs-5"></span>
            </button>
        }
        <button class="btn btn-danger ml-2" @onclick="ClosePrompt" data-bs-toggle="tooltip" data-bs-placement="bottom" title="Izlaz">
            <span class="fa fa-sign-in fs-5"></span>
        </button>
    </div>
</div>
<hr class="mt-2 mb-1" />
@if (_loading)
{
    <div class="spinner mt-5"></div>
}
else if (_group != null)
{
    <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <ul class="nav nav-tabs card-header-tabs">
                            <a class="nav-link cursor-pointer @addClassToActiveTab("details")" @onclick="@(() => SelectTab("details"))">Osnovni podaci</a>
                            <a class="nav-link cursor-pointer @addClassToActiveTab("editor")" @onclick="@(() => SelectTab("editor"))">Sadržaj</a>
                        </ul>
                    </div>
                    <div class="card-body">
                        @if (activeTab == "details")
                        {
                            <div class="form-group">
                                <label for="SectionName" class="form-label mb-1 mt-2">Naziv člana:</label>
                                <InputText class="form-control w-50" id="SectionName" @bind-Value="_model.Name"/>
                                <ValidationMessage For="@(() => _model.Name)" />
                            </div>
                            <div class="form-group">
                                <label for="Description" class="form-label mb-1 mt-2">Opis člana:</label>
                                <InputTextArea class="form-control w-50" id="Description" @bind-Value="_model.Description" rows="8"/>
                                <ValidationMessage For="@(() => _model.Description)" />
                            </div>
                        }
                        else if (activeTab == "editor")
                        {
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-2">
                                        @if (_isPlaceholderAvailable)
                                        {
                                            <label class="form-label mb-1 mt-2">Dostupni placeholderi:</label>
                                            <nav>
                                                <ul class="list-group navigation-list card-container-scroll">
                                                    @if (_placeholders.ContainsKey(string.Empty))
                                                    {
                                                        @foreach (var placeholder in _placeholders[string.Empty])
                                                        {
                                                            <li class="list-group-item cursor-pointer placeholder-item text-gray"
                                                                draggable="true"
                                                                ondragstart="drag(event)"
                                                                data-placeholder="@placeholder.Key">
                                                                @placeholder.Value
                                                            </li>
                                                        }
                                                    }
                                                    @foreach (var group in _placeholders.Where(p => p.Key != string.Empty))
                                                    {
                                                        <li class="list-group-item cursor-pointer group-header text-blue" onclick="toggleGroup('@group.Key')">
                                                            <i class="fas fa-caret-right" id="icon-@group.Key"></i> @group.Key
                                                        </li>
                                                        <ul id="@group.Key" class="list-group card-container-scroll placeholder-items" style="display:none; padding-left: 20px;">
                                                            @foreach (var placeholder in group.Value)
                                                            {
                                                                <li class="list-group-item cursor-pointer placeholder-item text-gray"
                                                                    draggable="true"
                                                                    ondragstart="drag(event)"
                                                                    data-placeholder="@placeholder.Key">
                                                                    @placeholder.Value
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </ul>
                                            </nav>
                                        }
                                    </div>
                                    <div class="col-10">
                                        <div class="form-group mt-2">
                                            <TinyMCE @bind-Value="_model.Content" @ref="tinyMceEditor" />
                                            <ValidationMessage For="@(() => _model.Content)" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Hidden field to ensure Content is validated -->
        <InputText class="d-none" @bind-Value="_model.Content" />
    </EditForm>
}
else
{
    <div class="row">
        <span class="text-center">Nije moguće pronaći podatke za traženu grupu!</span>
    </div>
}
