@page "/sections/{GroupId:int}"
@using AutoDocFront.Models.DTO
@using AutoDocFront.Models.DTO.GroupSection
@using AutoDocFront.Models.DTO.Sections
@using AutoDocFront.Models.Enumerations
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject IJSRuntime JSRuntime

<PageTitle>Članovi</PageTitle>

<div class="row align-items-center my-3">
    <div class="col">
        <h3>Članovi za grupu: "@_group?.Name"</h3>
    </div>
    <div class="col-auto">
        @if (_group != null)
        {
            <!-- Button to toggle search input visibility -->
            @*             <button class="btn btn-icon ml-2" @onclick="ToggleSearch" title="Pretrazi">
        <span class="fa fa-search fs-5"></span>
        </button> *@
            @if (_selectedSection != null)
            {
                <button class="btn btn-icon ml-2" @onclick="OpenHistoricalSectionModal" title="Ostale verzije ovog člana">
                    <span class="fas fa-history fs-5"></span>
                </button>

                <button class="btn btn-icon ml-2" @onclick="OpenEditSectionModal" title="Izmjeni odabrani član">
                    <span class="oi oi-pencil fs-5"></span>
                </button>
            }
            <!-- Button to show modal for adding a new group -->
            @* <button class="btn btn-icon ml-2 mr-2" @onclick="OpenNewSection" title="Unesi novi član">
                <span class="oi oi-plus fs-5"></span>
            </button> *@
            <button class="btn btn-icon ml-2 mr-2" @onclick="ShowSectionModalForInsert" title="Unesi novi član">
                <span class="oi oi-plus fs-5"></span>
            </button>
        }
        <!-- Button to close the prompt -->
        <button class="btn btn-danger ml-1" @onclick="ClosePrompt" title="Izlaz">
            <span class="fa fa-sign-in fs-5"></span>
        </button>
    </div>
</div>

<hr class="mt-2 mb-2" />

@if (_loading)
{
    <div class="spinner mt-5"></div>
}
else if (_group != null)
{
    <div class="row">
        <div class="col-3">
            <div class="input-group mt-1 mb-2 position-relative">
                <input @bind="_searchTerm" @bind:event="oninput" placeholder="Pretraga po nazivu člana" class="form-control pl-4" />
                <span class="position-absolute search-icon">
                    <i class="fa fa-search"></i>
                </span>
                <div class="input-group-append">
                    <button class="btn" type="button" @onclick="ToggleStatusFilter" title="Filter statusa">
                        <i class="fa fa-filter fs-5"></i>
                    </button>
                </div>
            </div>

            @if (_isStatusFilterVisible)
            {
                <div class="status-filters mt-2 mb-2">
                    @foreach (var status in Enum.GetValues<SectionStatusType>())
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" checked="@_selectedStatuses.Contains(status)" @onchange="(e) => OnStatusFilterChanged(e, status)" id="@status.ToString()" />
                            <label class="form-check-label" for="@status.ToString()">@GetEnumDescription(status)</label>
                        </div>
                    }
                </div>
            }
            @if (FilteredSections.Any())
            {
                <div class="card">
                    <div>

                        <h6 class="card-header">Lista članova</h6>
                        <!-- Left side navigation -->
                        <nav>
                            <ul class="list-group navigation-list section-list-container">
                                @foreach (var sectionItem in FilteredSections)
                                {
                                    <li class="list-group-item cursor-pointer @((_selectedSection?.ID == sectionItem.ID ? "active" : ""))" style="display:flex"
                                        @onclick="() => SelectSection(sectionItem)">
                                        @* @($"v{sectionItem.Version} | {sectionItem.Name}") *@
                                        <div class="flex-column me-2  align-content-center">
                                            @($"v{sectionItem.Version}")
                                        </div>
                                        <div class="border border-secondary me-1"></div>
                                        <div>
                                            @sectionItem.Name
                                        </div>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
        <div class="col-9">
            <!-- Right-side content/preview -->
            @if (_selectedSection != null)
            {
                <div class="card mb-2">
                    <h5 class="card-header cursor-pointer yellow-background" @onclick="() => ToggleVisibility(ref _isBasicDetailsVisible)">
                        Osnovni podaci
                        <span class="fas @(_isBasicDetailsVisible ? "fa-angle-down" : "fa-angle-right") ml-2" style="color:#FEE600"></span>
                    </h5>
                    @if (_isBasicDetailsVisible)
                    {
                        <div class="card-body">
                            <div class="card-title border-bottom">
                                <div class="row mb-1">
                                    <div class="col-2 border-end align-content-center text-center">
                                        <h5>Naziv</h5>
                                    </div>
                                    <div class="col-10">
                                        <h6>@_selectedSection.Name</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="card-text border-bottom">
                                <div class="row mb-1">
                                    <div class="col-2 border-end align-content-center text-center">
                                        <h5>Opis</h5>
                                    </div>
                                    <div class="col-10 mb-0">
                                        <span class="mb-0">@_selectedSection.Description</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="card flex-grow-1 mb-2 content-container @(_isBasicDetailsVisible ? "reduced-height" : "")">
                    <h5 class="card-header cursor-pointer justify-content-between align-items-center yellow-background sticky-header"
                        @onclick="() => ToggleVisibility(ref _isContentVisible)">
                        Sadržaj
                        <span class="fas @(_isContentVisible ? "fa-angle-down" : "fa-angle-right") ml-2" style="color:#FEE600"></span>
                    </h5>
                    @if (_isContentVisible)
                    {
                        <div class="card-body base-content-height content-full-height">
                            <div class="card-text">
                                <p>@(new MarkupString(_selectedSection.Content))</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="row">
        <span class="text-center">Nije moguće pronaći podatke za traženu grupu!</span>
    </div>
}

@if (_isSectionModalVisible)
{
    <AutoDocFront.Components.Modals.SectionsModal @ref="_sectionModal" IsOpen="@_isSectionModalVisible" IsOpenChanged="@((value) => _isSectionModalVisible = value)" Group="_group" Section="_selectedSection" ModalMode="_sectionModalMode" OnSave="OnSaveAsync" />
}