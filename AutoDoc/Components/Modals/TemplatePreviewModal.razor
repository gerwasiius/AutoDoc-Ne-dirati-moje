@* TemplatePreviewModal.razor *@
@if (IsOpen)
{
    <div class="modal show d-block" tabindex="-1" style="background:rgba(0,0,0,0.3);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Pregled dokumenta: @TemplateName</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body" style="min-height:400px;">
                    @if (IsLoading)
                    {
                        <div class="spinner"></div>
                    }
                    else if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger">@ErrorMessage</div>
                    }
                    else
                    {
                        <div class="border rounded p-3" style="background:#fff; min-height:300px; max-height:70vh; overflow:auto;">
                            @if (!string.IsNullOrEmpty(HtmlContent))
                            {
                                @((MarkupString)HtmlContent)
                            }
                            else
                            {
                                <span class="text-secondary">Nema sadržaja za prikaz.</span>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Close">Zatvori</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string TemplateName { get; set; }
    [Parameter] public string HtmlContent { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string ErrorMessage { get; set; }

    private async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }
}