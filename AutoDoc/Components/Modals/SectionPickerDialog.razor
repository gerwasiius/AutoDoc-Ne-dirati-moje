@if (IsOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.2)">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Dodaj sekcije</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <select class="form-select mb-2 corporate-select"
                            @bind="SelectedGroup"
                            @bind:after="OnGroupChangedHandler">
                            <option>Odaberi grupu</option>
                        @foreach (var group in AvailableGroups.Select(s => s.Name).Distinct())
                        {
                            <option value="@group">@group</option>
                        }
                    </select>
                    <input class="form-control mb-2" placeholder="Pretraga sekcija..." @bind="SectionSearchTerm" />
                    @foreach (var sectionItem in AvailableSections)
                    {
                        <div class="card mb-2 border-hover-warning" style="cursor:pointer">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <input type="checkbox" class="form-check-input me-2"
                                           checked="@SelectedSectionIds.Contains(sectionItem.ID)"
                                           @onchange="(e) => ToggleSectionSelection(sectionItem.ID, e.Value)" />
                                    <span class="fw-bold">@sectionItem.Name - v @sectionItem.Version</span>
                                    <small class="text-secondary ms-2">@sectionItem.Description</small>
                                </div>
                                @* <span class="badge bg-warning text-dark">@sectionItem.Name</span> *@
                            </div>
                        </div>
                    }
                     <button class="btn corporate-button-primary mt-2 w-100" @onclick="AddSelectedSections" disabled="@(SelectedSectionIds.Count == 0)">
                        Dodaj odabrane sekcije
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}
