@using AutoDocFront.Components.Shared
@using AutoDocFront.Utilities
@inherits ModalBase

<BaseModalLayout IsOpen="@IsOpen"
                 Title="Detalji placeholdera"
                 IsOpenChanged="@IsOpenChanged">
    <BodyContent>
        @if (Placeholder == null)
        {
            <div class="text-center text-secondary py-4">Nema podataka za prikaz.</div>
        }
        else
        {
            <dl class="row mb-0">
                <dt class="col-sm-4">Vrijednost</dt>
                <dd class="col-sm-8 text-monospace">@($"{Placeholder.Group}.{Placeholder.Name}")</dd>

                <dt class="col-sm-4">Grupa</dt>
                <dd class="col-sm-8">@Placeholder.Group</dd>

                <dt class="col-sm-4">Naziv</dt>
                <dd class="col-sm-8">@Placeholder.Name</dd>

                <dt class="col-sm-4">Opis</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrWhiteSpace(Placeholder.Description))
                    {
                        @Placeholder.Description
                    }
                    else
                    {
                        <span class="text-muted fst-italic">Nema opisa</span>
                    }
                </dd>

                <dt class="col-sm-4">Tip podatka</dt>
                <dd class="col-sm-8">
                    <span class="badge @PlaceholderHelpers.GetTypeBadgeClass(Placeholder.Type)">@Placeholder.Type</span>
                </dd>

                @* <dt class="col-sm-4">Moguća NULL vrijednost?</dt>
                <dd class="col-sm-8">
                    @if (Placeholder.IsNullable)
                    {
                        <span class="badge bg-green-100 text-green-800 border border-success d-flex align-items-center gap-1">DA</span>
                    }
                    else
                    {
                        <span class="badge bg-green-100 text-green-800 border border-success d-flex align-items-center gap-1">NE</span>
                    }
                </dd> *@

                <dt class="col-sm-4">Moguće vrijednosti</dt>
                <dd class="col-sm-8">
                    @if (Placeholder.EnumValues != null && Placeholder.EnumValues.Any())
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var value in Placeholder.EnumValues)
                            {
                                <span class="badge bg-green-100 text-green-800 border border-success d-flex align-items-center gap-1">
                                    @value
                                </span>

                            }
                        </div>
                    }
                    else
                    {
                        <span class="text-muted fst-italic">-</span>
                    }
                </dd>
            </dl>
        }
    </BodyContent>
    <FooterContent>
        <div class="modal-footer d-flex justify-content-end">
            <button class="btn btn-secondary" @onclick="Close">Zatvori</button>
        </div>
    </FooterContent>
</BaseModalLayout>
