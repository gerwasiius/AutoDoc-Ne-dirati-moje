@using AutoDocFront.Models.DTO.DocumentTemplateDTO
@using AutoDocFront.Models.Enumerations
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.FluentUI.AspNetCore.Components
@inject IHttpClientFactory httpClientFactory
@inject IToastService toastService

@if (IsOpen)
{
    <div class="modal-backdrop"></div>
    <div class="modal" tabindex="-1" role="dialog" style="@_modalStyle">
        <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">

                    <h5 class="modal-title">
                        @(
                            ModalMode == Models.Enumerations.ModalMode.EDIT
                            ? "Izmjena predloška"
                            : ModalMode == Models.Enumerations.ModalMode.VIEW
                            ? "Pregled predloška"
                            : "Unos novog predloška"
                            )
                    </h5>
                    <button type="button" class="btn-close me-2" aria-label="Close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="Name" class="form-label">
                                Naziv predloška
                                @if (ModalMode != ModalMode.VIEW)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>
                            <InputText class="form-control" id="Name" @bind-Value="_model.Name" disabled="@(ModalMode == ModalMode.VIEW)" />
                            <ValidationMessage For="@(() => _model.Name)" />
                        </div>
                        <div class="mb-3">
                            <label for="Description" class="form-label">Opis predloška <span class="text-danger">*</span></label>
                            <InputTextArea class="form-control" id="Description" @bind-Value="_model.Description" rows="3" disabled="@(ModalMode == ModalMode.VIEW)" />
                            <ValidationMessage For="@(() => _model.Description)" />
                        </div>
                        <div class="mb-3">
                            <label for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                            @if (ModalMode == ModalMode.EDIT)
                            {
                                <InputSelect class="form-control" id="Status" @bind-Value="_model.Status">
                                    <option value="">Odaberite status</option>
                                    @foreach (var item in Enum.GetValues(typeof(DocumentTemplateStatusType)))
                                    {
                                        <option value="@item">@item</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => _model.Status)" />
                            }
                            else
                            {
                                <input class="form-control" id="Status" value="@_model.Status" disabled />
                                <ValidationMessage For="@(() => _model.Status)" />
                            }
                        </div>
                        <div class="row">
                            <div class="col">
                                <label for="ValidFrom" class="form-label">Važi od <span class="text-danger">*</span></label>
                                <InputDate class="form-control" id="ValidFrom" @bind-Value="_model.ValidFrom" disabled="@(ModalMode == ModalMode.VIEW)" />
                                <ValidationMessage For="@(() => _model.ValidFrom)" />
                            </div>
                            <div class="col">
                                <label for="ValidTo" class="form-label">Važi do</label>
                                <div class="input-group">
                                    <InputDate class="form-control" id="ValidTo" @bind-Value="_model.ValidTo" disabled="@(isUnlimitedValidTo || ModalMode == ModalMode.VIEW)" />
                                    <div class="input-group-text ms-2">
                                        <input type="checkbox"
                                               class="form-check-input corporate-checkbox"
                                               id="unlimitedValidTo"
                                               checked="@isUnlimitedValidTo"
                                               @onchange="ToggleUnlimitedValidTo"
                                               disabled="@(ModalMode == ModalMode.VIEW)" />
                                        <label class="form-check-label ms-1" for="unlimitedValidTo">
                                            Bez vremenskog ograničenja
                                        </label>
                                    </div>
                                </div>
                                <ValidationMessage For="@(() => _model.ValidTo)" />
                            </div>
                        </div>
                    </EditForm>
                </div>
                @* <div class="modal-footer">
                    <button type="submit" class="btn btn-primary fs-6" @onclick="HandleValidSubmit" disabled="_loading">
                        <i class="oi oi-check me-1"></i>
                        Spasi
                    </button>
                </div> *@
                <div class="modal-footer d-flex justify-content-between align-items-center">
                    @if (ModalMode != ModalMode.VIEW)
                    {
                        <small class="text-muted">
                            <span class="text-danger">*</span> - označava mandatorna polja za popuniti.
                        </small>

                        <button type="submit" class="btn modal-corporate-button-primary fs-6" @onclick="HandleValidSubmit">
                            <i class="oi oi-check me-1"></i>
                            Spasi
                        </button>
                    }
                    else
                    {
                        <button class="btn corporate-button-secondary btn-sm" @onclick="() => OnEdit.InvokeAsync()">
                            <i class="fa fa-edit me-1"></i> Izmjena
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}
